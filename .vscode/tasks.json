{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dart help: what to do",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\reset_dart_tools.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Hard reset Dart/Flutter tools",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\reset_dart_tools.ps1",
        "-Hard"
      ],
      "problemMatcher": []
    },
    {
      "label": "Safe project check",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\safe_check.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run Windows (hide benign frame-time logs)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run_windows_filtered.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
